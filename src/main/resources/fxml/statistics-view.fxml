<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
       xmlns:fx="http://javafx.com/fxml"
       fx:controller="ru.mirea.shinomontazh.controller.StatisticsController"
       spacing="20">

       <padding>
              <Insets top="25"
                     right="25"
                     bottom="25"
                     left="25" />
       </padding>

       <Label text="Статистика"
              styleClass="section-title" />

       <Button text="Обновить статистику"
              onAction="#onRefreshButtonClick" />

       <GridPane hgap="40"
              vgap="18"
              styleClass="statistics-grid">

              <Label text="Всего заказов:"
                     GridPane.columnIndex="0"
                     GridPane.rowIndex="0" />

              <Label fx:id="totalOrdersLabel"
                     text="0"
                     styleClass="statistics-value"
                     GridPane.columnIndex="1"
                     GridPane.rowIndex="0" />


              <Label text="Новых заказов:"
                     GridPane.columnIndex="0"
                     GridPane.rowIndex="1" />

              <Label fx:id="newOrdersLabel"
                     text="0"
                     styleClass="statistics-value"
                     GridPane.columnIndex="1"
                     GridPane.rowIndex="1" />


              <Label text="В работе:"
                     GridPane.columnIndex="0"
                     GridPane.rowIndex="2" />

              <Label fx:id="inProgressOrdersLabel"
                     text="0"
                     styleClass="statistics-value"
                     GridPane.columnIndex="1"
                     GridPane.rowIndex="2" />


              <Label text="Выполнено:"
                     GridPane.columnIndex="0"
                     GridPane.rowIndex="3" />

              <Label fx:id="doneOrdersLabel"
                     text="0"
                     styleClass="statistics-value"
                     GridPane.columnIndex="1"
                     GridPane.rowIndex="3" />


              <Label text="Отменено:"
                     GridPane.columnIndex="0"
                     GridPane.rowIndex="4" />

              <Label fx:id="cancelledOrdersLabel"
                     text="0"
                     styleClass="statistics-value"
                     GridPane.columnIndex="1"
                     GridPane.rowIndex="4" />


              <Label text="Общая сумма заказов:"
                     GridPane.columnIndex="0"
                     GridPane.rowIndex="5" />

              <Label fx:id="totalPriceLabel"
                     text="0 ₽"
                     styleClass="statistics-value"
                     GridPane.columnIndex="1"
                     GridPane.rowIndex="5" />


              <Label text="Средняя стоимость:"
                     GridPane.columnIndex="0"
                     GridPane.rowIndex="6" />

              <Label fx:id="averagePriceLabel"
                     text="0 ₽"
                     styleClass="statistics-value"
                     GridPane.columnIndex="1"
                     GridPane.rowIndex="6" />


              <Label text="Максимальная стоимость:"
                     GridPane.columnIndex="0"
                     GridPane.rowIndex="7" />

              <Label fx:id="maxPriceLabel"
                     text="0 ₽"
                     styleClass="statistics-value"
                     GridPane.columnIndex="1"
                     GridPane.rowIndex="7" />

       </GridPane>

</VBox>