<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="ru.mirea.shinomontazh.controller.OrderController"
        spacing="15">

        <padding>

                <Insets top="25"
                        right="25"
                        bottom="25"
                        left="25" />

        </padding>


        <!-- ============================================== -->
        <!-- ЗАГОЛОВОК -->
        <!-- ============================================== -->

        <Label text="Заказы"
                styleClass="section-title" />


        <!-- ============================================== -->
        <!-- CRUD -->
        <!-- ============================================== -->

        <HBox spacing="10">

                <Button text="Добавить заказ"
                        onAction="#onAddButtonClick" />

                <Button text="Изменить"
                        onAction="#onEditButtonClick" />

                <Button text="Удалить"
                        onAction="#onDeleteButtonClick" />

                <Button text="Обновить"
                        onAction="#onRefreshButtonClick" />

                <Button text="Экспорт Excel"
                        onAction="#onExportButtonClick" />

        </HBox>


        <!-- ============================================== -->
        <!-- ПОИСК -->
        <!-- ============================================== -->

        <HBox spacing="10"
                alignment="CENTER_LEFT">

                <Label text="Поиск:" />

                <TextField fx:id="searchField"
                        promptText="Марка или госномер"
                        prefWidth="250"
                        onAction="#onSearchButtonClick" />

                <Button text="Найти"
                        onAction="#onSearchButtonClick" />

        </HBox>


        <!-- ============================================== -->
        <!-- ФИЛЬТРЫ + СОРТИРОВКА -->
        <!-- ============================================== -->

        <HBox spacing="10"
                alignment="CENTER_LEFT">

                <Label text="Статус:" />

                <ComboBox fx:id="statusFilter"
                        promptText="Все статусы"
                        prefWidth="150" />


                <Label text="Клиент:" />

                <ComboBox fx:id="clientFilter"
                        promptText="Все клиенты"
                        prefWidth="220" />


                <Label text="Сортировка:" />

                <ComboBox fx:id="sortComboBox"
                        prefWidth="150" />


                <Button text="Применить"
                        onAction="#onSearchButtonClick" />


                <Button text="Сбросить"
                        onAction="#onResetButtonClick" />

        </HBox>


        <!-- ============================================== -->
        <!-- КОЛИЧЕСТВО -->
        <!-- ============================================== -->

        <Label fx:id="resultCountLabel"
                text="Найдено заказов: 0" />


        <!-- ============================================== -->
        <!-- TABLEVIEW -->
        <!-- ============================================== -->

        <TableView fx:id="ordersTable"
                VBox.vgrow="ALWAYS">

                <columns>

                        <TableColumn fx:id="idColumn"
                                text="ID"
                                prefWidth="60" />

                        <TableColumn fx:id="carBrandColumn"
                                text="Марка"
                                prefWidth="130" />

                        <TableColumn fx:id="carNumberColumn"
                                text="Госномер"
                                prefWidth="120" />

                        <TableColumn fx:id="serviceColumn"
                                text="Услуга"
                                prefWidth="170" />

                        <TableColumn fx:id="statusColumn"
                                text="Статус"
                                prefWidth="130" />

                        <TableColumn fx:id="priceColumn"
                                text="Цена"
                                prefWidth="100" />

                        <TableColumn fx:id="dateColumn"
                                text="Дата"
                                prefWidth="180" />

                        <TableColumn fx:id="clientIdColumn"
                                text="Клиент ID"
                                prefWidth="100" />

                </columns>

        </TableView>

</VBox>