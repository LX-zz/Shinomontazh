<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="ru.mirea.shinomontazh.controller.ClientController"
        spacing="15">

        <padding>

                <Insets top="25"
                        right="25"
                        bottom="25"
                        left="25" />

        </padding>

        <Label text="Клиенты"
                styleClass="section-title" />

        <HBox spacing="10">

                <Button text="Добавить клиента"
                        onAction="#onAddButtonClick" />

                <Button text="Изменить"
                        onAction="#onEditButtonClick" />

                <Button text="Удалить"
                        onAction="#onDeleteButtonClick" />

                <Button text="Обновить"
                        onAction="#onRefreshButtonClick" />

        </HBox>

        <TableView fx:id="clientsTable"
                VBox.vgrow="ALWAYS">

                <columns>

                        <TableColumn fx:id="idColumn"
                                text="ID"
                                prefWidth="80" />

                        <TableColumn fx:id="fullNameColumn"
                                text="ФИО"
                                prefWidth="300" />

                        <TableColumn fx:id="phoneColumn"
                                text="Телефон"
                                prefWidth="220" />

                        <TableColumn fx:id="emailColumn"
                                text="Email"
                                prefWidth="300" />

                </columns>

        </TableView>

</VBox>